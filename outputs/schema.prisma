// Tuloy — PostgreSQL schema (Prisma). Source of truth for Guest, Staff and Admin.
// Conventions:
//  - Every hotel-owned row has hotelId (multi-property ready).
//  - Guest-facing hotel content is stored as Json { "en": "...", "fil": "...", "ceb": "..." }.
//    The API falls back to Hotel.defaultLocale when a key is missing.
//  - Money is Decimal(12,2) + ISO currency. No raw card data is ever stored.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Identity & access ─────────────────────────

enum Role {
  GUEST
  STAFF
  ADMIN
}

enum Locale {
  en
  fil
  ceb
}

model User {
  id            String    @id @default(uuid())
  email         String?   @unique
  phone         String?   @unique
  passwordHash  String
  fullName      String
  locale        Locale    @default(en)
  notifyPrefs   Json      @default("{}") // { push: true, email: true, sms: false, marketing: false }
  emailVerified DateTime?
  phoneVerified DateTime?
  mfaSecretEnc  String? // admins, later
  createdAt     DateTime  @default(now())
  disabledAt    DateTime?

  memberships    Membership[]
  refreshTokens  RefreshToken[]
  pushTokens     PushToken[]
  otpCodes       OtpCode[]
  reservations   Reservation[]
  loyalty        LoyaltyAccount[]
}

/// A user's role at a hotel. Guests get a GUEST membership on first booking/signup.
model Membership {
  id           String      @id @default(uuid())
  userId       String
  hotelId      String
  role         Role
  departmentId String?
  permissions  String[] // fine-grained, e.g. "booking.approve", "refund.create", "loyalty.adjust"
  createdAt    DateTime    @default(now())
  user         User        @relation(fields: [userId], references: [id])
  hotel        Hotel       @relation(fields: [hotelId], references: [id])
  department   Department? @relation(fields: [departmentId], references: [id])

  @@unique([userId, hotelId])
}

/// Rotating refresh tokens: one row per issued token; reuse of a revoked token revokes the family.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  familyId  String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id])

  @@index([familyId])
}

/// One-time codes for password reset / verification. Only the hash is stored.
model OtpCode {
  id        String    @id @default(uuid())
  userId    String
  purpose   String // reset | verify
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, purpose, createdAt])
}

model PushToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String // ios | android
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

// ───────────────────────── Hotel & rooms ─────────────────────────

model Hotel {
  id            String   @id @default(uuid())
  name          String
  timezone      String   @default("Asia/Manila")
  currency      String   @default("PHP")
  defaultLocale Locale   @default(en)
  locales       Locale[] @default([en, fil, ceb])
  taxRate       Decimal  @default(0.12) @db.Decimal(5, 4)
  serviceCharge Decimal  @default(0.10) @db.Decimal(5, 4)
  policies      Json     @default("{}") // checkIn/out times, deposit %, cancellation, no-show (translated)
  integrations  Json     @default("{}") // non-secret provider config; secrets live in Secrets Manager
  createdAt     DateTime @default(now())

  memberships Membership[]
  departments Department[]
  roomTypes   RoomType[]
}

model Department {
  id          String       @id @default(uuid())
  hotelId     String
  name        String
  hotel       Hotel        @relation(fields: [hotelId], references: [id])
  memberships Membership[]
}

model RoomType {
  id          String     @id @default(uuid())
  hotelId     String
  name        Json
  description Json
  photos      String[] // object-storage keys
  amenities   String[] // amenity keys, translated in the app
  maxGuests   Int
  basePrice   Decimal    @db.Decimal(12, 2) // per night when no RoomRate row exists
  active      Boolean    @default(true)
  hotel       Hotel      @relation(fields: [hotelId], references: [id])
  rooms       Room[]
  rates       RoomRate[]
}

model Room {
  id         String      @id @default(uuid())
  hotelId    String
  roomTypeId String
  number     String
  floor      String?
  active     Boolean     @default(true)
  roomType   RoomType    @relation(fields: [roomTypeId], references: [id])
  nights     RoomNight[]

  @@unique([hotelId, number])
}

/// Per-date price override (seasonal/promo rates). Missing date = RoomType.basePrice.
model RoomRate {
  roomTypeId String
  date       DateTime @db.Date
  price      Decimal  @db.Decimal(12, 2)
  roomType   RoomType @relation(fields: [roomTypeId], references: [id])

  @@id([roomTypeId, date])
}

enum NightKind {
  HOLD // checkout in progress; expires
  BOOKED
  BLOCKED // maintenance / admin inventory block
}

/// Inventory ledger: one row per physical room per night.
/// The unique (roomId, date) constraint is the double-booking guard — the DB refuses a second sale.
/// Booking flow: in one transaction delete expired HOLDs, then insert HOLD rows; on payment, flip to BOOKED.
model RoomNight {
  roomId        String
  date          DateTime     @db.Date
  hotelId       String
  kind          NightKind
  reservationId String?
  holdExpiresAt DateTime?
  note          String?
  room          Room         @relation(fields: [roomId], references: [id])
  reservation   Reservation? @relation(fields: [reservationId], references: [id])

  @@id([roomId, date])
  @@index([hotelId, date])
}

// ───────────────────────── Reservations & money ─────────────────────────

enum ReservationStatus {
  HOLD
  PENDING // awaiting payment or staff approval
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
  DECLINED
}

model Reservation {
  id             String            @id @default(uuid())
  hotelId        String
  code           String            @unique // guest-facing confirmation number
  guestId        String
  status         ReservationStatus
  checkIn        DateTime          @db.Date
  checkOut       DateTime          @db.Date
  adults         Int
  children       Int               @default(0)
  priceSnapshot  Json // nightly rates, add-ons, tax, policy text at booking time
  total          Decimal           @db.Decimal(12, 2)
  currency       String
  idempotencyKey String            @unique
  internalNotes  String?
  createdAt      DateTime          @default(now())
  guest          User              @relation(fields: [guestId], references: [id])
  nights         RoomNight[]
  payments       Payment[]
  invoiceLines   InvoiceLine[]
  serviceOrders  ServiceRequest[]
  wifi           WifiCredential[]

  @@index([hotelId, checkIn])
  @@index([hotelId, status])
}

/// Generic status history for reservations, service requests and restaurant orders.
/// ponytail: polymorphic (no FK); split into per-entity tables if reporting needs joins/constraints.
model StatusEvent {
  id         String   @id @default(uuid())
  hotelId    String
  entityType String // reservation | service_request | restaurant_order
  entityId   String
  fromStatus String?
  toStatus   String
  byUserId   String?
  note       String?
  at         DateTime @default(now())

  @@index([entityType, entityId])
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  ONLINE
  ROOM_CHARGE
  PAY_AT_OUTLET
  FREE
}

model Payment {
  id             String        @id @default(uuid())
  hotelId        String
  reservationId  String?
  serviceReqId   String?
  restaurantOrderId String?
  provider       String // paymongo | xendit | stripe
  providerRef    String?       @unique // intent/charge id
  amount         Decimal       @db.Decimal(12, 2)
  refundedAmount Decimal       @default(0) @db.Decimal(12, 2)
  currency       String
  status         PaymentStatus
  idempotencyKey String        @unique
  createdAt      DateTime      @default(now())
  reservation    Reservation?  @relation(fields: [reservationId], references: [id])
  refunds        Refund[]
}

model Refund {
  id          String   @id @default(uuid())
  paymentId   String
  amount      Decimal  @db.Decimal(12, 2)
  reason      String
  providerRef String?  @unique
  status      String // pending | succeeded | failed
  byUserId    String
  createdAt   DateTime @default(now())
  payment     Payment  @relation(fields: [paymentId], references: [id])
}

/// Raw webhook log. Unique providerEventId makes webhook handling idempotent.
model PaymentProviderEvent {
  id              String    @id @default(uuid())
  provider        String
  providerEventId String
  payload         Json
  processedAt     DateTime?
  receivedAt      DateTime  @default(now())

  @@unique([provider, providerEventId])
}

/// Guest folio. Room nights, services, restaurant room-charges and payments all land here.
model InvoiceLine {
  id            String      @id @default(uuid())
  hotelId       String
  reservationId String
  kind          String // room | service | restaurant | tax | payment | refund | loyalty_redemption
  description   Json
  amount        Decimal     @db.Decimal(12, 2) // payments/refunds negative
  sourceId      String?
  createdAt     DateTime    @default(now())
  reservation   Reservation @relation(fields: [reservationId], references: [id])
}

// ───────────────────────── Dynamic services ─────────────────────────

enum ServiceStatus {
  DRAFT
  PUBLISHED
  PAUSED
  ARCHIVED
}

enum PriceModel {
  FIXED
  PER_ITEM
  PER_PERSON
  PER_NIGHT
  QUOTE
}

enum AcceptanceMode {
  AUTO
  STAFF_APPROVAL
}

/// Publish is refused by the API until all required fields (see brief) are set.
/// Edits bump `version`; orders keep their own snapshot so history never changes.
model Service {
  id                 String          @id @default(uuid())
  hotelId            String
  category           String // laundry | cleaning | dining | transfer | wellness | amenity | extra
  status             ServiceStatus   @default(DRAFT)
  version            Int             @default(1)
  name               Json
  description        Json
  instructions       Json?
  imageKey           String?
  schedule           Json // { days: [1..7], from: "07:00", to: "22:00" }
  leadTimeMin        Int             @default(0)
  capacityPerSlot    Int?
  etaMin             Int?
  blackoutDates      DateTime[]      @db.Date
  priceModel         PriceModel
  basePrice          Decimal?        @db.Decimal(12, 2) // null only for QUOTE
  currency           String
  taxIncluded        Boolean         @default(false)
  paymentMethods     PaymentMethod[]
  fields             Json // form definition: [{ key, type, label{}, required, options? }]
  departmentId       String?
  acceptanceMode     AcceptanceMode  @default(STAFF_APPROVAL)
  statusSteps        String[] // e.g. ["requested","accepted","picked_up","processing","delivered"]
  cancellationPolicy Json
  loyaltyEarn        Boolean         @default(false)
  loyaltyRedeem      Boolean         @default(false)
  loyaltyTerms       Json?
  updatedAt          DateTime        @updatedAt
  options            ServiceOption[]
  requests           ServiceRequest[]

  @@index([hotelId, status])
}

model ServiceOption {
  id         String  @id @default(uuid())
  serviceId  String
  name       Json
  priceDelta Decimal @default(0) @db.Decimal(12, 2)
  active     Boolean @default(true)
  service    Service @relation(fields: [serviceId], references: [id])
}

model ServiceRequest {
  id             String        @id @default(uuid())
  hotelId        String
  serviceId      String
  guestId        String
  reservationId  String?
  status         String // one of the snapshot's statusSteps, or cancelled / escalated
  snapshot       Json // service name/options/price/tax/policy at order time
  answers        Json // guest form input
  scheduledFor   DateTime?
  total          Decimal?      @db.Decimal(12, 2) // null until quoted
  paymentMethod  PaymentMethod
  assigneeId     String?
  idempotencyKey String        @unique
  createdAt      DateTime      @default(now())
  service        Service       @relation(fields: [serviceId], references: [id])
  reservation    Reservation?  @relation(fields: [reservationId], references: [id])

  @@index([hotelId, status])
  @@index([assigneeId])
}

// ───────────────────────── Restaurant QR ─────────────────────────

model Outlet {
  id      String           @id @default(uuid())
  hotelId String
  name    Json
  schedule Json
  posRef  String?
  tables  RestaurantTable[]
  items   MenuItem[]
}

model RestaurantTable {
  id       String        @id @default(uuid())
  outletId String
  label    String // shown prominently to the guest
  active   Boolean       @default(true)
  outlet   Outlet        @relation(fields: [outletId], references: [id])
  qrTokens TableQrToken[]
}

/// QR payload = opaque random token. Only its hash is stored; retire by setting revokedAt.
model TableQrToken {
  id        String          @id @default(uuid())
  tableId   String
  tokenHash String          @unique
  revokedAt DateTime?
  createdAt DateTime        @default(now())
  table     RestaurantTable @relation(fields: [tableId], references: [id])
}

model MenuItem {
  id          String   @id @default(uuid())
  outletId    String
  category    Json
  name        Json
  description Json?
  imageKey    String?
  price       Decimal  @db.Decimal(12, 2)
  allergens   String[]
  available   Boolean  @default(true)
  posRef      String?
  outlet      Outlet   @relation(fields: [outletId], references: [id])
}

model RestaurantOrder {
  id             String        @id @default(uuid())
  hotelId        String
  outletId       String
  tableId        String
  guestId        String?
  reservationId  String?
  status         String // submitted | accepted | preparing | served | cancelled
  items          Json // [{ menuItemId, name{}, price, qty, notes }] snapshot
  allergyNotes   String?
  total          Decimal       @db.Decimal(12, 2)
  paymentMethod  PaymentMethod
  posRef         String?
  idempotencyKey String        @unique
  createdAt      DateTime      @default(now())

  @@index([outletId, status])
}

// ───────────────────────── Chat ─────────────────────────

model Conversation {
  id            String    @id @default(uuid())
  hotelId       String
  guestId       String
  reservationId String?
  serviceReqId  String?
  closedAt      DateTime?
  createdAt     DateTime  @default(now())
  messages      Message[]

  @@index([hotelId, closedAt])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  body           String // original text, never overwritten
  attachments    String[]
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId, createdAt])
}

// ───────────────────────── Loyalty (ledger) ─────────────────────────

model LoyaltyAccount {
  id      String               @id @default(uuid())
  userId  String
  hotelId String
  balance Int                  @default(0) // cache; ledger sum is the truth
  tier    String               @default("member")
  user    User                 @relation(fields: [userId], references: [id])
  txns    LoyaltyTransaction[]

  @@unique([userId, hotelId])
}

/// Immutable. Earn after completed stay/paid service; reverse on refund.
model LoyaltyTransaction {
  id         String         @id @default(uuid())
  accountId  String
  points     Int // + earn, - redeem/expire/reverse
  kind       String // earn | redeem | adjust | expire | reverse
  sourceType String?
  sourceId   String?
  byUserId   String? // required for adjust
  reason     String?
  createdAt  DateTime       @default(now())
  account    LoyaltyAccount @relation(fields: [accountId], references: [id])

  @@unique([kind, sourceType, sourceId]) // no double earn for the same stay/order
}

model LoyaltyReward {
  id      String  @id @default(uuid())
  hotelId String
  name    Json
  points  Int
  value   Decimal @db.Decimal(12, 2)
  active  Boolean @default(true)
}

// ───────────────────────── Wi-Fi ─────────────────────────

model WifiCredential {
  id            String      @id @default(uuid())
  hotelId       String
  reservationId String
  username      String
  secretEnc     String // encrypted at rest
  validFrom     DateTime
  validUntil    DateTime // = checkout time
  status        String // active | revoked | expired
  providerRef   String?
  reservation   Reservation @relation(fields: [reservationId], references: [id])
}

// ───────────────────────── Staff ops ─────────────────────────

model LeaveRequest {
  id         String    @id @default(uuid())
  hotelId    String
  userId     String
  from       DateTime  @db.Date
  to         DateTime  @db.Date
  type       String
  reason     String?
  status     String // pending | approved | rejected
  decidedBy  String?
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())
}

// ───────────────────────── Content, notifications, feedback, audit ─────────────────────────

model ContentItem {
  id          String    @id @default(uuid())
  hotelId     String
  kind        String // guide | promotion | banner
  title       Json
  body        Json
  imageKey    String?
  publishedAt DateTime?
  expiresAt   DateTime?
}

model NotificationTemplate {
  id      String @id @default(uuid())
  hotelId String
  event   String // booking.confirmed, payment.receipt, service.updated ...
  channel String // push | email | sms
  subject Json?
  body    Json

  @@unique([hotelId, event, channel])
}

model NotificationDelivery {
  id          String    @id @default(uuid())
  hotelId     String
  userId      String
  event       String
  channel     String
  status      String // queued | sent | delivered | failed
  providerRef String?
  attempts    Int       @default(0)
  error       String?
  createdAt   DateTime  @default(now())
  sentAt      DateTime?

  @@index([userId, createdAt])
}

model Feedback {
  id            String   @id @default(uuid())
  hotelId       String
  guestId       String
  reservationId String?
  serviceReqId  String?
  rating        Int
  comment       String?
  createdAt     DateTime @default(now())
}

/// Append-only. Written for every admin/staff mutation and every money movement.
model AuditLog {
  id         String   @id @default(uuid())
  hotelId    String?
  actorId    String?
  action     String // e.g. reservation.cancel, refund.create, service.publish
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ip         String?
  at         DateTime @default(now())

  @@index([hotelId, at])
  @@index([entityType, entityId])
}
