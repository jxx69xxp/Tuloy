DATABASE_URL=postgresql://tuloy:tuloy@localhost:5432/tuloy
# Direct (unpooled) connection for migrations; the same URL locally.
DATABASE_URL_UNPOOLED=postgresql://tuloy:tuloy@localhost:5432/tuloy
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me
PORT=3000
# Password for seeded demo users (admin@tuloy.test, staff@tuloy.test, guest@tuloy.test)
SEED_PASSWORD=ChangeMe123!

# Base URL the outside world uses to reach this API (checkout return page, mock checkout, webhooks)
PUBLIC_API_URL=http://localhost:3000

# Payments: mock (dev, fake checkout page) | paymongo
PAYMENT_PROVIDER=mock
# Demo deployments only: lets PAYMENT_PROVIDER=mock run with NODE_ENV=production (no money moves).
ALLOW_MOCK_PAYMENTS=
PAYMONGO_SECRET_KEY=
# From the PayMongo dashboard webhook for checkout_session.payment.paid -> {PUBLIC_API_URL}/v1/webhooks/payments/paymongo
PAYMONGO_WEBHOOK_SECRET=

# Notifications: log (print only) | resend / semaphore / fcm
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM=Tuloy <no-reply@example.com>
SMS_PROVIDER=log
SEMAPHORE_API_KEY=
SMS_SENDER_NAME=
PUSH_PROVIDER=log
# Firebase service account JSON on one line
FCM_SERVICE_ACCOUNT=

# Set to off to disable background jobs (hold expiry, notification sending) in this process
# JOBS: unset = timers in-process; off = none; inline = serverless (send now + /v1/internal/cron)
JOBS=on

# Object storage for photos (S3, Cloudflare R2, Supabase Storage S3 API, or MinIO from docker-compose)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tuloy
S3_ACCESS_KEY=tuloy
S3_SECRET_KEY=tuloy-dev-secret
# Public base URL for stored files (CDN in production). Defaults to S3_ENDPOINT/S3_BUCKET
ASSET_BASE_URL=

# Encrypts Wi-Fi passwords at rest. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_KEY=

# Wi-Fi vouchers: log | webhook (POST {action, username, password, validUntil, room} to your RADIUS/vendor bridge)
WIFI_PROVIDER=log
WIFI_WEBHOOK_URL=
WIFI_WEBHOOK_TOKEN=

# Comma-separated browser origins allowed to call this API (web app). Empty = localhost only in development, none in production
# Each entry must be an exact origin without a trailing slash, e.g. https://staff.example.com
CORS_ORIGINS=
